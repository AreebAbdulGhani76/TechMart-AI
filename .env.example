# 1. Google Gemini API Key
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Google Service Account Credentials
# Path to the service account JSON key file with Google Sheets & Drive API scopes
GOOGLE_APPLICATION_CREDENTIALS=leads-data-serviceaccount.json

# Optional: Directly provide the Service Account JSON string for cloud environments (Vercel, Railway, etc.)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# 3. Live Google Sheets IDs & GIDs
PRODUCTS_SHEET_ID=1RZ1U4TKfqqjY4kpbvFUQOJd_PwDlYp0I
PRODUCTS_GID=1097220337

ORDERS_SHEET_ID=18G2BQlwSihkgC5JcCFosbMVEbSQBQE_hgvKpFogcWCI
ORDERS_GID=1288216522

BANK_DETAILS_SHEET_ID=1gWgVsSVU4u1V8qTcEIKj7F81XxY02Y-0sJCdc-J6gNg
BANK_DETAILS_GID=0

# 4. Automated Customer Email Dispatch (Gmail SMTP)
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_store_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
